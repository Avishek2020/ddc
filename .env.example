# ================================
#  DDC website — environment vars
#  Fill in the values, then restart the server (npm start).
#  Do NOT commit this file (it is git-ignored).
# ================================

# --- Server ---
PORT=
ADMIN_PASSWORD=
SESSION_SECRET=

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Google OAuth (admin sign-in) ---
# Create at Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional; defaults to http://localhost:3000/auth/google/callback
GOOGLE_CALLBACK_URL=
# Comma-separated Google emails allowed into the admin
ADMIN_EMAILS=
